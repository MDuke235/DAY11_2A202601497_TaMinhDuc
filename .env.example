# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# Cấu hình NVIDIA NIM. Dán API key NVIDIA NIM thật vào .env, không vào file này.
LLM_PROVIDER=nvidia_nim
NVIDIA_NIM_API_KEY=your-nvidia-nim-key-here
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia_nim/meta/llama-3.1-8b-instruct

# STUDENT_ID phải là MSSV thật để các tệp outputs/*.json không dùng giá trị mẫu.
STUDENT_ID=2A202601497